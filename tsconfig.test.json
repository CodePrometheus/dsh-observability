{
  // The test tier's compiler face. `tsconfig.json` is the build face and emits
  // from `src` alone, while vitest strips types without checking them, so
  // without this config nothing type-checks `tests/` — the one place seam
  // record values are hand-built and can drift from the published types.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "declarationDir": null,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
